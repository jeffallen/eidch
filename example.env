# Example environment configuration for EID-CH Verifier Agent OID4VP Go Port

# Required Configuration
EXTERNAL_URL=http://localhost:8080
VERIFIER_DID=did:example:test-verifier
DID_VERIFICATION_METHOD=did:example:test-verifier#key-1

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Storage Configuration
STORAGE_TYPE=jsonfile
STORAGE_DATA_DIR=./verification-data

# Verification Process Configuration
EXPIRATION_DURATION=5m

# Optional: JWT Signing (uncomment to enable signed request objects)
# SIGNING_KEY=-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEIF...(your-private-key)...\n-----END EC PRIVATE KEY-----

# Optional: Client Metadata File
# OPENID_CLIENT_METADATA_FILE=./client_metadata.json
